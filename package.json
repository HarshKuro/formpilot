{
  "name": "formpilot-extension",
  "version": "1.0.0",
  "description": "Privacy-first student profile autofill browser extension for Google Forms",
  "author": "Harsh Partap Jain <harshpartapjainsdg@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-extension.js all",
    "build:chrome": "vite build && node scripts/package-extension.js chrome",
    "build:firefox": "vite build && node scripts/package-extension.js firefox",
    "package:zip": "node scripts/zip-extension.js",
    "set-version": "node scripts/set-version.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/adm-zip": "^0.6.0",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
